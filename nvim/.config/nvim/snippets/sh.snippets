snippet skel
	#!/bin/bash
	set -euo pipefail
  	# set -x
	${0}
snippet #!
	#!/bin/bash
snippet stric
	set -euo pipefail
  	# set -x
	${0}
snippet strict
	set -o errexit
	set -o nounset
	set -o pipefail
	set -o xtrace

  ${0}
snippet ifs
  # IFS=$' \n\t'
  ${0}
snippet sc
  # shellcheck disable=SC${1:0000}
snippet $
  "${${0:}}"
snippet func
  # DESC: ${1:}
  # ARGS: ${2:}
  ${3:func_name}() {
    ${0::}
  }
snippet scriptname
	declare -gr SCRIPTNAME="$(realpath "${BASH_ARGV0}")"
snippet :#
  : # Not Implemented
